<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iamywl.github.io</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap');
        body { font-family: 'Noto Sans KR', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">
    <div id="app"></div>

    <script src="js/data.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const app = document.getElementById('app');
            
            if (typeof resumeData === 'undefined') {
                app.innerHTML = '<div class="text-center p-10 text-red-500">데이터를 불러올 수 없습니다. (js/data.js 확인 필요)</div>';
                return;
            }
            
            const data = resumeData;

            app.innerHTML = `
                <div class="max-w-4xl mx-auto my-12 p-8 sm:p-12 bg-white shadow-2xl rounded-3xl border border-slate-100">
                    
                    <!-- Header -->
                    <header class="mb-10 text-center md:text-left">
                        <div class="inline-block px-3 py-1 bg-blue-600 text-white text-xs font-bold rounded-md mb-4 shadow-sm">
                            #${data.profile.keyword}
                        </div>
                        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-2 tracking-tight">${data.profile.name}</h1>
                        <p class="text-lg md:text-xl font-bold text-slate-500 mb-6 uppercase tracking-widest">${data.profile.title}</p>
                        <div class="flex flex-wrap justify-center md:justify-start gap-4 text-slate-600 font-medium text-sm">
                            <span><i class="fas fa-envelope mr-2"></i>${data.profile.email}</span>
                            <span><i class="fab fa-github mr-2"></i><a href="https://github.com/${data.profile.github}" target="_blank" class="underline hover:text-blue-600">GitHub</a></span>
                        </div>
                    </header>

                    <!-- Summary -->
                    <section class="mb-16">
                        <div class="p-8 bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl shadow-xl relative overflow-hidden">
                            <p class="text-lg leading-relaxed text-slate-100 relative z-10 font-medium">
                                "${data.profile.summary}"
                            </p>
                        </div>
                    </section>

                    <!-- Projects -->
                    <section class="mb-16">
                        <h2 class="text-xs font-black uppercase tracking-widest text-blue-600 mb-8 flex items-center">
                            KEY PROJECTS <span class="ml-2 h-px bg-slate-200 flex-grow"></span>
                        </h2>
                        <div class="space-y-12">
                            ${data.projects.map(pj => `
                                <div class="group border-l-4 border-transparent hover:border-blue-500 pl-6 transition-all">
                                    <h3 class="text-2xl font-bold text-slate-900 mb-1">${pj.title}</h3>
                                    <p class="text-sm text-slate-400 mb-4 font-mono">${pj.period}</p>
                                    <p class="text-md text-slate-700 mb-4 font-bold leading-snug">${pj.description}</p>
                                    <ul class="text-sm text-slate-500 space-y-2 mb-6">
                                        ${pj.points.map(pt => `<li class="flex items-start"><span class="mr-2 text-blue-500">✔</span>${pt}</li>`).join('')}
                                    </ul>
                                    ${pj.link && pj.link !== '#' ? `<a href="${pj.link}" target="_blank" class="inline-block text-xs font-black text-blue-600 border-b-2 border-blue-600 pb-1 hover:text-blue-800 transition">GitHub Repository <i class="fas fa-arrow-right ml-1"></i></a>` : ''}
                                </div>
                            `).join('')}
                        </div>
                    </section>

                    <!-- Awards -->
                    <section class="mb-16">
                        <h2 class="text-xs font-black uppercase tracking-widest text-blue-600 mb-8 flex items-center">
                            AWARDS <span class="ml-2 h-px bg-slate-200 flex-grow"></span>
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            ${data.awards.map(aw => `
                                <div class="flex justify-between items-center p-4 bg-slate-50 rounded-xl border border-slate-100 shadow-sm">
                                    <div>
                                        <p class="text-sm font-bold text-slate-800 leading-tight">${aw.title}</p>
                                        <p class="text-[10px] text-slate-400 mt-1">${aw.org}</p>
                                    </div>
                                    <span class="text-[10px] font-mono text-slate-300 ml-4 whitespace-nowrap">${aw.date}</span>
                                </div>
                            `).join('')}
                        </div>
                    </section>

                    <!-- Tech Stack -->
                    <section>
                        <h2 class="text-xs font-black uppercase tracking-widest text-blue-600 mb-8 flex items-center">
                            TECH STACK <span class="ml-2 h-px bg-slate-200 flex-grow"></span>
                        </h2>
                        <div class="grid grid-cols-3 md:grid-cols-6 gap-4">
                            ${data.techStack.map(tech => `
                                <div class="flex flex-col items-center p-4 rounded-2xl bg-white border border-slate-100 shadow-sm hover:scale-105 transition-transform duration-300">
                                    <img src="${tech.img}" class="h-10 w-10 object-contain mb-3" onerror="this.style.display='none'">
                                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-tighter text-center">${tech.name}</span>
                                </div>
                            `).join('')}
                        </div>
                    </section>

                    <!-- Footer -->
                    <footer class="text-center mt-16 pt-8 border-t border-slate-200">
                        <p class="text-xs text-slate-400 font-mono">
                            Last Deployed: <span id="deploy-timestamp">__DEPLOY_TIMESTAMP__</span>
                        </p>
                    </footer>
                </div>
            `;
        });
    </script>
</body>
</html>